# PFOS local demo environment (copy to .env.local and fill from `supabase status`)
# Demo-mode gate is SERVER-only (never NEXT_PUBLIC_ — it is not a secret)
PFOS_DEMO_MODE=1
# Optional: when set, POST /api/demo/reset requires the x-pfos-reset-token header
# PFOS_DEMO_RESET_TOKEN=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_KEY=placeholder-from-supabase-status
# Agent (Slice 2+):
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini
